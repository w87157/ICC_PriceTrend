<!doctype html>
<html lang="zh-TW">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="PriceTrend Admin Dashboard" />
    <title>@ViewData["Title"] - PriceTrend Admin</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/css/admin/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/admin/vendors/bootstrap-icons/bootstrap-icons.css" />
    <!-- Admin CSS -->
    <link rel="stylesheet" href="~/css/admin/style.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="admin-shell">
        <div class="sidebar-backdrop" data-sidebar-close></div>

        <aside class="admin-sidebar" id="adminSidebar" aria-label="Main navigation">
            <div class="sidebar-header">
                <a class="brand-mark" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <span class="brand-icon">
                        <i class="bi bi-grid-1x2-fill" aria-hidden="true"></i>
                    </span>

                    <span class="brand-copy">
                        <span class="brand-title">比價期趨</span>
                        <span class="brand-subtitle">PriceTrend</span>
                    </span>
                </a>
            </div>

            @{
                var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
            }
            <nav class="sidebar-nav">
                <a class="nav-link @(currentController == "Dashboard" ? "active" : "")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <span class="nav-icon">
                        <i class="bi bi-speedometer2" aria-hidden="true"></i>
                    </span>
                    <span class="nav-text">儀錶板</span>
                </a>

                <a class="nav-link @(currentController == "User" ? "active" : "")" asp-area="Admin" asp-controller="User" asp-action="Index">
                    <span class="nav-icon">
                        <i class="bi bi-people" aria-hidden="true"></i>
                    </span>
                    <span class="nav-text">使用者管理</span>
                </a>

                <a class="nav-link" href="#">
                    <span class="nav-icon">
                        <i class="bi bi-graph-up" aria-hidden="true"></i>
                    </span>
                    <span class="nav-text">價格分析</span>
                </a>

                <a class="nav-link" href="#">
                    <span class="nav-icon">
                        <i class="bi bi-search" aria-hidden="true"></i>
                    </span>
                    <span class="nav-text">熱門搜尋</span>
                </a>

                 <a class="nav-link" href="#">
                    <span class="nav-icon">
                        <i class="bi bi-robot" aria-hidden="true"></i>
                    </span>
                    <span class="nav-text">爬蟲監控</span>

                </a>

                <a class="nav-link" href="#">
                    <span class="nav-icon">
                        <i class="bi bi-file-earmark-bar-graph" aria-hidden="true"></i>
                    </span>
                    <span class="nav-text">報表</span>
                </a>
            </nav>

            <div class="sidebar-user">
                <div class="sidebar-user-avatar avatar-img avatar-md">
                    <i class="bi bi-person-fill"></i>
                </div>
                <strong>Admin</strong>
                <small>PriceTrend 管理員</small>
            </div>
        </aside>

        <div class="admin-main">
            <nav class="navbar admin-navbar navbar-expand bg-white">
                <div class="container-fluid px-3 px-lg-4">
                    <button class="sidebar-toggle" type="button" data-sidebar-toggle aria-controls="adminSidebar"
                            aria-expanded="true" aria-label="Toggle sidebar">
                        <span></span>
                        <span></span>
                        <span></span>
                    </button>

                    <form class="d-none d-md-flex ms-3 flex-grow-1" role="search">
                        <input class="form-control search-input" type="search" placeholder="搜尋商品、價格、關鍵字..." aria-label="Search" />
                    </form>

                    <div class="navbar-actions ms-auto">
                        <button class="icon-button theme-toggle" type="button" data-theme-toggle
                                aria-label="Switch color theme">
                            <i class="bi bi-moon-stars" data-theme-icon aria-hidden="true"></i>
                        </button>
                        <div class="dropdown">
                            <button class="icon-button" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Notifications">
                                <span class="notification-dot"></span>
                                <i class="bi bi-bell" aria-hidden="true"></i>
                            </button>

                            <div class="dropdown-menu dropdown-menu-end notification-menu">
                                <div class="dropdown-header fw-bold text-body">Notifications</div>
                                <a class="dropdown-item" href="#">
                                    <span class="notification-title">爬蟲任務完成</span>
                                    <span class="notification-time">5 分鐘前</span>
                                </a>
                                <a class="dropdown-item" href="#">
                                    <span class="notification-title">發現價格變化</span>
                                    <span class="notification-time">20 分鐘前</span>
                                </a>
                            </div>
                        </div>

                        <div class="dropdown">
                            <button class="profile-button dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="avatar-img avatar-sm"><i class="bi bi-person-fill"></i></span>
                                <span class="profile-name d-none d-sm-inline">Admin</span>
                            </button>

                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="#">個人資料</a></li>
                                <li><a class="dropdown-item" href="#">系統設定</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" href="#">登出</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </nav>

            <main class="dashboard-content">
                @RenderBody()
            </main>
        </div>
    </div>


    <!-- Bootstrap JS -->
    <script src="~/lib/admin/vendors/bootstrap/js/bootstrap.bundle.min.js">
    </script>

    <!-- Admin JS -->
    <script src="~/js/admin/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin/main.js"></script>
    
    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>