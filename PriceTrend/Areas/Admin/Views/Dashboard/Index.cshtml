@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid px-3 px-lg-4 py-4">
    <div class="page-heading">
        <div class="page-heading-copy">
            <span class="page-icon">
                <i class="bi bi-speedometer2" aria-hidden="true"></i>
            </span>

            <div>
                <p class="eyebrow mb-1">PriceTrend Admin</p>
                <h1 class="h3 mb-1">儀錶板</h1>
                <p class="text-muted mb-0">價格分析與系統管理總覽</p>
            </div>
        </div>


        <div class="heading-actions">
            <button class="btn btn-outline-secondary btn-sm" type="button">
                <i class="bi bi-download" aria-hidden="true"></i>匯出報表
            </button>
        </div>
    </div>

    <section class="row g-3 mt-1" aria-label="Dashboard metrics">
        <div class="col-12 col-sm-6 col-xl-3">
            <article class="metric-card metric-primary">
                <div class="metric-top">
                    <span class="metric-label">商品總數</span>
                    <span class="metric-icon">
                        <i class="bi bi-box-seam" aria-hidden="true"></i>
                    </span>
                </div>
                <div class="metric-value">0</div>
                <div class="metric-meta">
                    <span>Items</span>
                </div>
            </article>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <article class="metric-card metric-success">
                <div class="metric-top">
                    <span class="metric-label">電商平台</span>
                    <span class="metric-icon">
                        <i class="bi bi-shop" aria-hidden="true"></i>
                    </span>
                </div>
                <div class="metric-value">0</div>
                <div class="metric-meta">
                    <span>Platforms</span>
                </div>
            </article>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <article class="metric-card metric-warning">
                <div class="metric-top">
                    <span class="metric-label">歷史價格紀錄</span>
                    <span class="metric-icon">
                        <i class="bi bi-clock-history" aria-hidden="true"></i>
                    </span>
                </div>
                <div class="metric-value">0</div>
                <div class="metric-meta">
                    <span>Price Histories</span>
                </div>
            </article>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <article class="metric-card metric-danger">
                <div class="metric-top">
                    <span class="metric-label">爬蟲任務</span>
                    <span class="metric-icon">
                        <i class="bi bi-robot" aria-hidden="true"></i>
                    </span>
                </div>
                <div class="metric-value">0</div>
                <div class="metric-meta">
                    <span>Crawler Tasks</span>
                </div>
            </article>
        </div>
    </section>

    <section class="row g-3 mt-1">
        <div class="col-12 col-xl-8">
            <div class="panel h-100">
                <div class="panel-header">
                    <div>
                        <h2 class="h5 mb-1 section-title">
                            <i class="bi bi-graph-up-arrow" aria-hidden="true"></i>
                            <span>價格趨勢</span>
                        </h2>
                        <p class="text-muted mb-0">商品近期價格變化</p>
                    </div>
                    <button class="btn btn-light btn-sm" type="button">查看詳細</button>
                </div>

                <div class="p-4">
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-bar-chart-line fs-1"></i>
                        <p class="mt-3 mb-0">價格趨勢圖將顯示於此</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-4">
            <div class="panel h-100">
                <div class="panel-header">
                    <div>
                        <h2 class="h5 mb-1 section-title">
                            <i class="bi bi-activity" aria-hidden="true"></i>
                            <span>爬蟲狀態</span>
                        </h2>

                        <p class="text-muted mb-0">各平台目前執行狀態</p>
                    </div>
                </div>

                <div class="p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span>PChome</span>
                        <span class="badge bg-success">正常</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span>Momo</span>
                        <span class="badge bg-success">正常</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <span>Shopee</span>
                        <span class="badge bg-secondary">尚未執行</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="row g-3 mt-1">
        <div class="col-12 col-xl-6">
            <div class="panel">
                <div class="panel-header">
                    <div>
                        <h2 class="h5 mb-1 section-title">
                            <i class="bi bi-search" aria-hidden="true"></i>
                            <span>熱門搜尋</span>
                        </h2>
                        <p class="text-muted mb-0">使用者近期熱門搜尋關鍵字</p>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>排名</th>
                                <th>關鍵字</th>
                                <th class="text-end">搜尋次數</th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr>
                                <td>1</td>
                                <td>iPhone 15</td>
                                <td class="text-end">0</td>
                            </tr>

                            <tr>
                                <td>2</td>
                                <td>RTX 5070</td>
                                <td class="text-end">0</td>
                            </tr>

                            <tr>
                                <td>3</td>
                                <td>AirPods Pro</td>
                                <td class="text-end">0</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-6">
            <div class="panel">
                <div class="panel-header">
                    <div>
                        <h2 class="h5 mb-1 section-title">
                            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                            <span>疑似假降價</span>
                        </h2>

                        <p class="text-muted mb-0">根據歷史價格分析的可疑商品</p>
                    </div>
                </div>

                <div class="p-4">
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-check-circle fs-1"></i>
                        <p class="mt-3 mb-0">目前沒有疑似假降價商品</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>