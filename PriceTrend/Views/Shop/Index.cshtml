                <div class="product-color mb-3">
                    <h4>Select By Color</h4>

                    <ul class="list-unstyled">
                        <li>
                            <div class="product-color-item">
                                <a href="#" class="text-dark">
                                    <i class="fas fa-apple-alt text-secondary me-2"></i>
                                    Gold
                                </a>
                                <span>(1)</span>
                            </div>
                        </li>

                        <li>
                            <div class="product-color-item">
