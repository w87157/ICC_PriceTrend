                           id="rangeInput"
                           name="rangeInput"
                           min="0"
                           max="500"
                           value="0"
                           oninput="amount.value=rangeInput.value">

                    <output id="amount"
                            name="amount"
                            min-velue="0"
                            max-value="500"
                            for="rangeInput">
                        0
                    </output>

                    <div class=""></div>
                </div>


