                                    <i class="fas fa-apple-alt text-secondary me-2"></i>
                                    Accessories
                                </a>
                                <span>(3)</span>
                            </div>
                        </li>

                        <li>
                            <div class="categories-item">
                                <a href="#" class="text-dark">
                                    <i class="fas fa-apple-alt text-secondary me-2"></i>
                                    Electronics & Computer
                                </a>
                                <span>(5)</span>
                            </div>
                        </li>

                        <li>
                            <div class="categories-item">
                                <a href="#" class="text-dark">
                                    <i class="fas fa-apple-alt text-secondary me-2"></i>
