@model List<PriceTrend.Models.Product.SearchResultViewModel>

@{
    ViewData["Title"] = "Shop";
}

<!-- Single Page Header start -->
<div class="container-fluid page-header py-5">
    <h1 class="text-center text-white display-6 wow fadeInUp" data-wow-delay="0.1s">商品搜尋結果</h1>
    <ol class="breadcrumb justify-content-center mb-0 wow fadeInUp" data-wow-delay="0.3s">
        <li class="breadcrumb-item"><a href="/">首頁</a></li>
        <li class="breadcrumb-item"><a href="#">分頁</a></li>
        <li class="breadcrumb-item active text-white">商品</li>
    </ol>
</div>
<!-- Single Page Header End -->
<!-- Shop Page Start -->
<div class="container-fluid shop py-5">
    <div class="container py-5">
        <div class="row g-4">

            <!-- 右側商品區 -->
            <div class="wow fadeInUp" data-wow-delay="0.1s">
                <!-- Search / Sort / View -->
                <div class="row g-4">

                    <div class="col-xl-7">
                        <div class="input-group w-100 mx-auto d-flex">
                            <input type="search"
                                   class="form-control p-3"
                                   placeholder="keywords"
                                   aria-describedby="search-icon-1">

                            <span id="search-icon-1"
                                  class="input-group-text p-3">
                                <i class="fa fa-search"></i>
                            </span>
                        </div>
                    </div>

                    <div class="col-xl-3 text-end">
                        <div class="bg-light ps-3 py-3 rounded d-flex justify-content-between">
                            <label for="sortSelect">Sort By:</label>

                            <select id="sortSelect"
                                    class="border-0 form-select-sm bg-light me-3">

                                <option value=""
                                        selected="@(string.IsNullOrEmpty(ViewBag.Sort) ? "selected" : null)">
                                    預設排序
                                </option>

                                <option value="price_asc"
                                        selected="@(ViewBag.Sort == "price_asc" ? "selected" : null)">
                                    價格由低到高
                                </option>

                                <option value="price_desc"
                                        selected="@(ViewBag.Sort == "price_desc" ? "selected" : null)">
                                    價格由高到低
                                </option>

                            </select>
                        </div>
                    </div>

                    <div class="col-lg- col-xl-2">
                        <ul class="nav nav-pills d-inline-flex text-center py-2 px-2 rounded bg-light mb-4">

                            <li class="nav-item me-4">
                                <a class="bg-light"
                                   data-bs-toggle="pill"
                                   href="#tab-5">
                                    <i class="fas fa-th fa-3x text-primary"></i>
                                </a>
                            </li>
                        </ul>
                    </div>

                </div>


                <!-- Product List -->
                <div class="tab-content">
                    <div id="tab-5"
                         class="tab-pane fade show p-0 active">
                        <div class="row g-4 product">
                            @foreach (var item in Model)
                            {
                                <div class="col-lg-3">
                                    <div class="product-item">
                                        <!-- 商品卡片主體 -->
                                        <div class="product-item-inner">
                                            <!-- 商品圖片區 -->
                                            <div class="product-item-inner-item">
                                                <a asp-controller="Product"
                                                   asp-action="Single"
                                                   asp-route-id="@item.ItemGuid">
                                                    <img src="@(string.IsNullOrWhiteSpace(item.MainImageUrl) ?
                                                                Url.Content("~/lib/home/img/No_Image.png") :
                                                                item.MainImageUrl)"
                                                         class="img-fluid w-100 rounded-top"
                                                         alt="@item.ItemName" />
                                                </a>

                                                <!-- 商品詳細資訊按鈕區 -->
                                                <div class="product-details">
                                                    <a asp-controller="Product"
                                                       asp-action="Single"
                                                       asp-route-id="@item.ItemGuid">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                </div>
                                            </div>

                                            <!-- 商品文字資訊 -->
                                            <div class="text-center rounded-bottom p-4">
                                                <h5>
                                                    <a asp-controller="Product"
                                                       asp-action="Single"
                                                       asp-route-id="@item.ItemGuid">
                                                        @item.ItemName
                                                    </a>
                                                </h5>

                                                @* 
                                                @if (!string.IsNullOrWhiteSpace(item.Brand))
                                                {
                                                    <p class="mb-1">@item.Brand</p>
                                                }

                                                @if (!string.IsNullOrWhiteSpace(item.Model))
                                                {
                                                    <p class="mb-2">@item.Model</p>
                                                }

                                                <span class="text-primary">
                                                    NT$ @item.LowestPrice
                                                </span>
                                                *@

                                                @{
                                                    decimal lowestPrice;
                                                    decimal highestPrice;

                                                    bool hasLowestPrice = decimal.TryParse(item.LowestPrice, out lowestPrice);
                                                    bool hasHighestPrice = decimal.TryParse(item.HighestPrice, out highestPrice);
                                                }

                                                @if (hasLowestPrice)
                                                {
                                                    <span class="text-danger">
                                                        NT$ @lowestPrice.ToString("N0")
                                                    </span>

                                                    @if (hasHighestPrice && highestPrice != lowestPrice)
                                                    {
                                                        <span class="text-danger">
                                                            ~ NT$ @highestPrice.ToString("N0")
                                                        </span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted">
                                                        暫無價格
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            <!-- Pagination -->
                            <div class="col-12 wow fadeInUp" data-wow-delay="0.1s">
                                <div class="pagination d-flex justify-content-center mt-5">
                                    @{
                                        int currentPage = ViewBag.CurrentPage ?? 1;
                                        int totalPages = ViewBag.TotalPages ?? 1;
                                        int maxPagesToShow = 5;
                                        int startPage = Math.Max(1, currentPage - maxPagesToShow / 2);
                                        int endPage = Math.Min(totalPages, startPage + maxPagesToShow - 1);
                                        if (endPage - startPage + 1 < maxPagesToShow)
                                        {
                                            startPage = Math.Max(1, endPage - maxPagesToShow + 1);
                                        }
                                    }
                                    @* 上一頁 *@
                                    @if (ViewBag.CurrentPage > 1)
                                    {
                                        <a asp-controller="Shop"
                                           asp-action="Index"
                                           asp-route-keyword="@ViewBag.Keyword"
                                           asp-route-sort="@ViewBag.Sort"
                                           asp-route-page="@(ViewBag.CurrentPage - 1)"
                                           class="rounded"> &laquo;
                                        </a>
                                    }
                                    @if (startPage > 1)
                                    {
                                        <a asp-controller="Shop"
                                           asp-action="Index"
                                           asp-route-keyword="@ViewBag.Keyword"
                                           asp-route-sort="@ViewBag.Sort"
                                           asp-route-page="1"
                                           class="rounded">1</a>

                                        @if (startPage > 2)
                                        {
                                            <span class="rounded px-2">...</span>
                                        }
                                    }
                                    @for (int i = startPage; i <= endPage; i++)
                                    {
                                        <a asp-controller="Shop"
                                           asp-action="Index"
                                           asp-route-keyword="@ViewBag.Keyword"
                                           asp-route-sort="@ViewBag.Sort"
                                           asp-route-page="@i"
                                           class="rounded @(i == currentPage ? "active" : "")">
                                            @i
                                        </a>
                                    }
                                    @if (endPage < totalPages)
                                    {
                                        @if (endPage < totalPages - 1)
                                        {
                                            <span class="rounded px-2">...</span>
                                        }

                                        <a asp-controller="Shop"
                                           asp-action="Index"
                                           asp-route-keyword="@ViewBag.Keyword"
                                           asp-route-sort="@ViewBag.Sort"
                                           asp-route-page="@totalPages"
                                           class="rounded">@totalPages</a>
                                    }

                                    @* 下一頁 *@
                                    @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                                    {
                                        <a asp-controller="Shop"
                                           asp-action="Index"
                                           asp-route-keyword="@ViewBag.Keyword"
                                           asp-route-sort="@ViewBag.Sort"
                                           asp-route-page="@(ViewBag.CurrentPage + 1)"
                                           class="rounded">&raquo;
                                        </a>
                                    }

                                </div>
                            </div>

                        </div>
                    </div>

                </div>

            </div>

        </div>
    </div>
</div>
<!-- Shop Page End -->
<script>
    document.getElementById("sortSelect")
        .addEventListener("change", function() {

            const sort = this.value;

            const params =
                new URLSearchParams(window.location.search);

            params.set("sort", sort);

            params.set("page", 1);

            window.location =
                "/Shop?" + params.toString();
        });
</script>