<!doctype html>
<html lang="zh-Hant">

<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - ICC_PriceTrend</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta content="" name="keywords" />
    <meta content="" name="description" />

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />

    <!-- Icon Font Stylesheet -->
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" />

    <!-- Libraries Stylesheet -->
    <link rel="stylesheet" href="~/lib/home/animate/animate.min.css" />
    <link rel="stylesheet" href="~/lib/home/owlcarousel/assets/owl.carousel.min.css" />

    <!-- Customized Bootstrap Stylesheet -->
    <link rel="stylesheet" href="~/css/home/bootstrap.min.css" />

    <!-- Template Stylesheet -->
    <link rel="stylesheet" href="~/css/home/style.css" />
</head>

<body>

    <!-- Spinner Start -->
    <div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
        <div class="spinner-border text-primary" style="width: 3rem; height: 3rem" role="status">
            <span class="sr-only">載入中...</span>
        </div>
    </div>
    <!-- Spinner End -->
    <!-- ========================================================= -->
    <!-- Fixed Header Start -->
    <!-- ========================================================= -->
    <div class="fixed-top bg-white shadow-sm" style="z-index: 1030;">

        <!-- Brand / Search Start -->
        <div class="container-fluid px-5 py-4">
            <div class="row gx-0 align-items-center">

                <!-- Logo -->
                <div class="col-lg-3 text-center text-lg-start mb-3 mb-lg-0">
                    <a href="/" class="navbar-brand p-0">
                        <h1 class="display-6 text-primary m-0">
                            <i class="fas fa-chart-line text-secondary me-2"></i>比價期趨
                        </h1>
                        <small class="text-muted ms-1">智慧比價．掌握價格趨勢</small>
                    </a>
                </div>

                <!-- Search -->
                <div class="col-lg-7">
                    <div class="px-lg-4">
                        <form asp-controller="Search" asp-action="Index" method="get" onsubmit="return validateSearch();">
                            <div class="d-flex border rounded-pill overflow-hidden">
                                <input name="keyword"
                                       id="searchKeyword"
                                       class="form-control border-0 border-start rounded-0 py-3"
                                       type="search"
                                       value="@Context.Request.Query["keyword"]"
                                       placeholder="請輸入商品關鍵字..."
                                       aria-label="商品搜尋" />

                                <button type="submit"
                                        class="btn btn-primary rounded-0 px-4 text-nowrap"
                                        style="min-width: 90px; white-space: nowrap">
                                    <i class="fas fa-search me-1"></i>搜尋
                                </button>
                            </div>
                        </form>
                    </div>
                </form>

                <div class="mt-2 ms-3">
                    <small class="text-muted me-2">熱門搜尋：</small>
                    <a href="~/Search/Index?keyword=iPhone" class="text-muted me-3">iPhone</a>
                    <a href="~/Search/Index?keyword=RTX" class="text-muted me-3">RTX 顯示卡</a>
                    <a href="~/Search/Index?keyword=MacBook" class="text-muted me-3">MacBook</a>
                    <a href="~/Search/Index?keyword=Switch" class="text-muted">Switch 2</a>
                </div>
            </div>
            <!-- 3. 右側功能圖示與會員中心 -->
            <div class="d-flex align-items-center mb-3 mb-lg-0">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a href="~/Profile/Index#v-pills-favorites" class="d-inline-flex align-items-center text-muted me-3" title="我的收藏">
                        <span class="rounded-circle btn-md-square border d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                            <i class="fas fa-heart"></i>
                        </span>
                    </a>

                    <a href="~/Profile/Index#v-pills-notifications" class="d-inline-flex align-items-center text-muted me-3" title="降價通知">
                        <span class="rounded-circle btn-md-square border d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                            <i class="fas fa-bell"></i>
                        </span>
                    </a>

                    <div class="d-flex align-items-center">
                        <a href="~/Profile/Index" class="d-inline-flex align-items-center text-muted me-2" title="會員中心">
                            <span class="rounded-circle btn-md-square border bg-primary text-white d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                <i class="fas fa-user"></i>
                            </span>
                        </a>
                        <a href="~/Account/Logout" class="text-danger small text-decoration-none fw-bold" title="登出">登出</a>
                    </div>
                }
                else
                {
                    <a href="~/Account/Login" class="d-inline-flex align-items-center text-muted text-decoration-none" title="登入帳號">
                        <span class="rounded-circle btn-md-square border d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                            <i class="fas fa-user"></i>
                        </span>
                    </a>
                }
            </div>

        </div>
    </div>
    <!-- Brand / Search End -->
    <!-- Navbar Start -->
    <div class="container-fluid nav-bar p-0">
        <div class="row gx-0 bg-primary px-5 align-items-center">
            <!-- Main Navigation -->
            <div class="col-12">
                <nav class="navbar navbar-expand-lg navbar-light bg-primary">
                    <a href="/" class="navbar-brand d-block d-lg-none">
                        <h1 class="display-6 text-secondary m-0">
                            <i class="fas fa-chart-line text-white me-2"></i>
                            ICC PriceTrend
                        </h1>
                    </a>
                </div>

            </div>
        </div>
        <!-- Brand / Search End -->

        <!-- Navigation Bar Start -->
        <div class="container-fluid nav-bar p-0">
            <div class="row gx-0 bg-primary" style="height: 62px;">
                <!-- 導覽列區塊 -->
            </div>
        </div>
        <!-- Navigation Bar End -->

    </div>
    <!-- Fixed Header End -->

    <!-- Header Spacer (避免 Content 被 fixed-top Header 遮擋) -->
    <div style="height: 187px;"></div>

    <!-- ========================================================= -->
    <!-- Main Content -->
    <!-- ========================================================= -->
    @RenderBody()

    <!-- Copyright Start -->
    <div class="container-fluid copyright py-4">
        <div class="container">
            <div class="row g-4 align-items-center">
                <div class="col-md-6 text-center text-md-start mb-md-0">
                    <span class="text-white">
                        <a href="#" class="border-bottom text-white">
                            <i class="fas fa-copyright text-light me-2"></i>您的網站名稱
                        </a>
                        ，保留所有權利。
                    </span>
                </div>
                <div class="col-md-6 text-center text-md-end text-white">
                    網頁設計：
                    <a class="border-bottom text-white" href="https://htmlcodex.com">HTML Codex</a>
                    ｜ 發行單位：
                    <a class="border-bottom text-white" href="https://themewagon.com">ThemeWagon</a>
                </div>
            </div>
        </div>
    </div>
    <!-- Copyright End -->

    <!-- Back to Top -->
    <a href="#" class="btn btn-primary btn-lg-square back-to-top">
        <i class="fa fa-arrow-up"></i>
    </a>

    <!-- JavaScript Libraries -->
    <script>
            document.addEventListener("DOMContentLoaded", function() {
        var hash = window.location.hash;
        if (hash) {
            var triggerEl = document.querySelector('.nav-pills a[href="' + hash + '"]');
            if (triggerEl) {
                triggerEl.click();
            }
        }

        var tabLinks = document.querySelectorAll('.nav-pills a');
        tabLinks.forEach(function(link) {
            link.addEventListener('click', function() {
                window.location.hash = this.getAttribute('href');
            });
        });
    });
</script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/home/wow/wow.min.js"></script>
    <script src="~/lib/home/owlcarousel/owl.carousel.min.js"></script>

    <!-- Page Validation & Template Scripts -->
    <script>
            function validateSearch() {
                const keyword = document.getElementById("searchKeyword").value.trim();
                return keyword !== "";
            }
    </script>
    <script src="~/js/home/main.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>