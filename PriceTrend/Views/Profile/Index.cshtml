@model PriceTrend.Models.User
@{
    ViewData["Title"] = "會員中心";
    Layout = "_Layout";
}

<!-- Breadcrumb Start -->
<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-12">
            <nav class="breadcrumb bg-light mb-30">
                <a class="breadcrumb-item text-dark" href="~/Home/Index">首頁</a>
                <span class="breadcrumb-item active">會員中心</span>
            </nav>
        </div>
    </div>
</div>
<!-- Breadcrumb End -->
<!-- Profile Start -->
<div class="container-fluid py-5">
    <div class="row px-xl-5">
        <!-- 側邊選單 -->
        <div class="col-lg-3 col-md-4 mb-5">
            <div class="bg-light p-4 mb-30 h-100">
                <div class="nav flex-column nav-pills" id="v-pills-tab" role="tablist" aria-orientation="vertical">
                    <!-- 注意這裡已經修正為 data-bs-toggle="pill" -->
                    <a class="nav-link active bg-primary text-dark font-weight-bold mb-2" id="v-pills-profile-tab" data-bs-toggle="pill" href="#v-pills-profile" role="tab">
                        <i class="fas fa-id-card me-2"></i>個人帳戶 / 個人資料
                    </a>
                    <a class="nav-link text-dark font-weight-bold mb-2" id="v-pills-favorites-tab" data-bs-toggle="pill" href="#v-pills-favorites" role="tab">
                        <i class="fas fa-heart me-2"></i>願望清單
                    </a>
                    <a class="nav-link text-dark font-weight-bold mb-2" id="v-pills-watchlist-tab" data-bs-toggle="pill" href="#v-pills-watchlist" role="tab">
                        <i class="fas fa-credit-card me-2"></i>我的卡片
                    </a>
                    <a class="nav-link text-dark font-weight-bold mb-2" id="v-pills-notifications-tab" data-bs-toggle="pill" href="#v-pills-notifications" role="tab">
                        <i class="fas fa-bell me-2"></i>訊息通知
                    </a>
                    <a class="nav-link text-dark font-weight-bold mb-2" id="v-pills-settings-tab" data-bs-toggle="pill" href="#v-pills-settings" role="tab">
                        <i class="fas fa-cog me-2"></i>帳號設定
                    </a>
                </div>
            </div>
        </div>

        <!-- 內容區域 -->
        <div class="col-lg-9 col-md-8 mb-5">
            <div class="tab-content bg-light p-30 h-100" id="v-pills-tabContent">

                <!-- 1. 個人資料 Tab -->
                <div class="tab-pane fade show active" id="v-pills-profile" role="tabpanel">
                    <h4 class="mb-4">個人資料</h4>

                    @if (TempData["SuccessMessage"] != null && Context.Request.Query["fragment"] != "v-pills-settings")
                    {
                        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                    }

                    <form asp-controller="Profile" asp-action="UpdateProfile" method="post">
                        <div class="row">
                            <div class="col-md-6 form-group">
                                <label>名字</label>
                                <input class="form-control" type="text" name="firstName" value="@Model?.FirstName" required>
                            </div>
                            <div class="col-md-6 form-group">
                                <label>姓氏</label>
                                <input class="form-control" type="text" name="lastName" value="@Model?.LastName" required>
                            </div>
                            <div class="col-md-6 form-group">
                                <label>電子郵件 (帳號無法修改)</label>
                                <input class="form-control" type="email" value="@Model?.Email" readonly>
                            </div>
                            <div class="col-md-6 form-group">
                                <label>手機號碼</label>
                                <input class="form-control" type="text" name="phoneNumber" value="@Model?.PhoneNumber" placeholder="請輸入手機號碼">
                            </div>
                            <div class="col-md-12 mt-3">
                                <button type="submit" class="btn btn-primary py-2 px-4">儲存變更</button>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- 2. 願望清單 Tab -->
                <div class="tab-pane fade" id="v-pills-favorites" role="tabpanel">
                    <h4 class="mb-4">願望清單 (商品收藏)</h4>
                    <p class="text-muted">這裡會顯示您點擊愛心收藏的所有商品清單。</p>
                </div>

                <!-- 3. 我的卡片 Tab -->
                <div class="tab-pane fade" id="v-pills-watchlist" role="tabpanel">
                    <h4 class="mb-4">我的卡片</h4>
                    <p class="text-muted">管理您的信用卡與付款方式。</p>
                </div>

                <!-- 4. 訊息通知 Tab -->
                <div class="tab-pane fade" id="v-pills-notifications" role="tabpanel">
                    <h4 class="mb-4">訊息通知</h4>
                    <div class="list-group">
                        <div class="list-group-item list-group-item-action">
                            <h6 class="mb-1 text-primary"><i class="fas fa-tags me-2"></i>系統通知</h6>
                            <p class="mb-1 text-muted">歡迎來到比價期趨！系統已成功建立您的帳戶。</p>
                        </div>
                    </div>
                </div>

                <!-- 5. 帳號設定 Tab -->
                <div class="tab-pane fade" id="v-pills-settings" role="tabpanel">
                    <h4 class="mb-4">帳號設定 - 修改密碼</h4>

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                    }
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                    }

                    <form asp-controller="Profile" asp-action="ChangePassword" method="post">
                        <div class="row">
                            <div class="col-md-12 form-group">
                                <label>目前密碼</label>
                                <input class="form-control" type="password" name="currentPassword" placeholder="請輸入目前的密碼" required>
                            </div>
                            <div class="col-md-12 form-group">
                                <label>新密碼</label>
                                <input class="form-control" type="password" name="newPassword" placeholder="請設定新密碼" required>
                            </div>
                            <div class="col-md-12 mt-3">
                                <button type="submit" class="btn btn-primary py-2 px-4">更新密碼</button>
                            </div>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>
<!-- Profile End -->

<script>
    document.addEventListener("DOMContentLoaded", function() {
        var hash = window.location.hash;
        if (hash) {
            var triggerEl = document.querySelector('.nav-pills a[href="' + hash + '"]');
            if (triggerEl) {
                // 使用 Bootstrap 5 的方式觸發
                var tab = new bootstrap.Tab(triggerEl);
                tab.show();
            }
        }

        var tabLinks = document.querySelectorAll('.nav-pills a');
        tabLinks.forEach(function(link) {
            link.addEventListener('click', function() {
                window.location.hash = this.getAttribute('href');
            });
        });
    });
</script>