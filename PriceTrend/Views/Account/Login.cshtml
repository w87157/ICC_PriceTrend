@{
    ViewData["Title"] = "會員登入";
    Layout = "_Layout";
}

<!-- Breadcrumb Start -->
<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-12">
            <nav class="breadcrumb bg-light mb-30">
                <a class="breadcrumb-item text-dark" href="~/Home/Index">首頁</a>
                <span class="breadcrumb-item active">會員登入</span>
            </nav>
        </div>
    </div>
</div>
<!-- Breadcrumb End -->
<!-- Login Start -->
<div class="container-fluid py-5">
    <div class="row justify-content-center px-xl-5">
        <div class="col-lg-6 mb-5">

            <!-- 🌟 這裡已經替換為乾淨、無背景色的標題 -->
            <h3 class="text-center text-dark mb-4 font-weight-bold">會員登入</h3>

            <div class="bg-light p-30 mb-5">
                <form asp-controller="Account" asp-action="Login" method="post">
                    <div class="row">
                        <div class="col-md-12 form-group">
                            <label>電子郵件</label>
                            <input class="form-control" type="email" name="email" placeholder="example@email.com" required>
                        </div>
                        <div class="col-md-12 form-group">
                            <label>密碼</label>
                            <input class="form-control" type="password" name="password" placeholder="請輸入密碼" required>
                        </div>
                        <div class="col-md-12 form-group d-flex justify-content-between align-items-center">
                            <div class="custom-control custom-checkbox">
                                <input type="checkbox" class="custom-control-input" id="remember">
                                <label class="custom-control-label" for="remember">記住我</label>
                            </div>
                            <a href="#">忘記密碼？</a>
                        </div>
                        <div class="col-md-12 mt-3">
                            <button type="submit" class="btn btn-block btn-primary font-weight-bold py-3">登入</button>
                        </div>
                        <div class="col-md-12 mt-3 text-center">
                            <span>還沒有帳號嗎？</span> <a asp-controller="Account" asp-action="Register" class="text-primary font-weight-bold">立即註冊</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<!-- Login End -->