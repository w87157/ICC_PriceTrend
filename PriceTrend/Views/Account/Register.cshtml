@{
    ViewData["Title"] = "註冊新帳號";
    Layout = "_Layout";
}

<!-- Breadcrumb Start -->
<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-12">
            <nav class="breadcrumb bg-light mb-30">
                <a class="breadcrumb-item text-dark" href="~/Home/Index">首頁</a>
                <span class="breadcrumb-item active">註冊帳號</span>
            </nav>
        </div>
    </div>
</div>
<!-- Breadcrumb End -->
<!-- Register Start -->
<div class="container-fluid py-5">
    <div class="row justify-content-center px-xl-5">
        <div class="col-lg-6 mb-5">
            <h5 class="section-title position-relative text-uppercase mb-3 text-center"><span class="bg-secondary pr-3">註冊新帳號</span></h5>
            <div class="bg-light p-30 mb-5">
                <form asp-controller="Account" asp-action="Register" method="post">
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label>名字</label>
                            <!-- 加上 name="firstName" -->
                            <input class="form-control" type="text" name="firstName" placeholder="John" required>
                        </div>
                        <div class="col-md-6 form-group">
                            <label>姓氏</label>
                            <!-- 加上 name="lastName" -->
                            <input class="form-control" type="text" name="lastName" placeholder="Doe" required>
                        </div>
                        <div class="col-md-12 form-group">
                            <label>電子郵件</label>
                            <!-- 加上 name="email" -->
                            <input class="form-control" type="email" name="email" placeholder="example@email.com" required>
                        </div>
                        <div class="col-md-6 form-group">
                            <label>設定密碼</label>
                            <!-- 加上 name="password" -->
                            <input class="form-control" type="password" name="password" placeholder="請設定密碼" required>
                        </div>

                        <!-- 確認密碼這欄只是讓使用者比對用，後端不需要接收，所以可以不用加 name -->
                        <div class="col-md-6 form-group">
                            <label>確認密碼</label>
                            <input class="form-control" type="password" placeholder="請再次輸入密碼" required>
                        </div>

                        <div class="col-md-12 mt-3">
                            <button type="submit" class="btn btn-block btn-primary font-weight-bold py-3">建立帳號</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<!-- Register End -->